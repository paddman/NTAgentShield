{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntagentshield.local/schemas/action.schema.json",
  "title": "NTAgentShield Action Request",
  "type": "object",
  "required": ["id", "tool", "reason", "risk", "mode", "trigger_trust", "requested_by", "requested_at", "expires_at"],
  "properties": {
    "id": {"type": "string"},
    "tool": {"type": "string"},
    "args": {"type": "object"},
    "reason": {"type": "string"},
    "risk": {"enum": ["observe", "contain", "modify", "destructive"]},
    "mode": {"enum": ["observe", "plan", "act", "auto"]},
    "trigger_trust": {"enum": ["system", "signed_policy", "operator", "trusted_config", "untrusted_telemetry", "untrusted_code", "untrusted_network"]},
    "requested_by": {"type": "string"},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approval": {
      "type": "object",
      "required": ["id", "action_digest", "approved_by", "approved_at", "expires_at"],
      "properties": {
        "id": {"type": "string"},
        "action_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
