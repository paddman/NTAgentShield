{
  "agent_id": "",
  "tenant_id": "replace-with-tenant-id",
  "data_dir": "C:\\ProgramData\\NTAgentShield",
  "poll_interval": "2s",
  "sources": [
    {
      "id": "iis-default-site",
      "enabled": true,
      "path": "C:\\inetpub\\logs\\LogFiles\\W3SVC1\\u_ex*.log",
      "format": "iis_w3c",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    },
    {
      "id": "normalized-windows-events",
      "enabled": false,
      "path": "C:\\ProgramData\\NTAgentShield\\ingest\\windows-events.jsonl",
      "format": "jsonl",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    }
  ],
  "api": {
    "enabled": true,
    "listen": "127.0.0.1:9477",
    "token_file": "agent-api.token"
  },
  "tools": {
    "policy_file": "C:\\Program Files\\NTAgentShield\\policies\\default-policy.json",
    "allowed_paths": [
      "C:\\inetpub\\logs",
      "C:\\ProgramData\\NTAgentShield"
    ]
  },
  "ai": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "NTAGENTSHIELD_AI_API_KEY",
    "allow_remote": false,
    "timeout": "30s"
  }
}
