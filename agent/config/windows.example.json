{
  "agent_id": "",
  "tenant_id": "replace-with-tenant-id",
  "data_dir": "C:\\ProgramData\\NTAgentShield",
  "poll_interval": "2s",
  "inventory": {
    "enabled": true,
    "interval": "15m",
    "command_timeout": "20s",
    "include_processes": true,
    "include_services": true,
    "include_listeners": true,
    "include_software": true,
    "max_items": 1000
  },
  "native_sources": [
    {
      "id": "windows-security",
      "enabled": true,
      "kind": "windows_eventlog",
      "channel": "Security",
      "event_ids": [1102, 4624, 4625, 4648, 4672, 4688, 4697, 4698, 4720, 4728, 4732, 5156, 5157],
      "from_start": false,
      "max_batch": 512,
      "command_timeout": "20s"
    },
    {
      "id": "windows-system",
      "enabled": true,
      "kind": "windows_eventlog",
      "channel": "System",
      "event_ids": [7045],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "20s"
    },
    {
      "id": "sysmon-operational",
      "enabled": true,
      "kind": "sysmon",
      "channel": "Microsoft-Windows-Sysmon/Operational",
      "event_ids": [1, 3, 6, 7, 8, 10, 11, 12, 13, 14, 15, 17, 18, 19, 20, 21, 22, 23, 25, 26, 29],
      "from_start": false,
      "max_batch": 512,
      "command_timeout": "20s"
    },
    {
      "id": "powershell-operational",
      "enabled": true,
      "kind": "windows_eventlog",
      "channel": "Microsoft-Windows-PowerShell/Operational",
      "event_ids": [4103, 4104],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "20s"
    }
  ],
  "sources": [
    {
      "id": "iis-default-site",
      "enabled": true,
      "path": "C:\\inetpub\\logs\\LogFiles\\W3SVC1\\u_ex*.log",
      "format": "iis_w3c",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    },
    {
      "id": "normalized-windows-events",
      "enabled": false,
      "path": "C:\\ProgramData\\NTAgentShield\\ingest\\windows-events.jsonl",
      "format": "jsonl",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    }
  ],
  "api": {
    "enabled": true,
    "listen": "127.0.0.1:9477",
    "token_file": "agent-api.token"
  },
  "tools": {
    "policy_file": "C:\\Program Files\\NTAgentShield\\policies\\default-policy.json",
    "allowed_paths": [
      "C:\\inetpub\\logs",
      "C:\\ProgramData\\NTAgentShield"
    ]
  },
  "ai": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "NTAGENTSHIELD_AI_API_KEY",
    "allow_remote": false,
    "timeout": "30s"
  }
}
