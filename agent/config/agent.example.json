{
  "agent_id": "",
  "tenant_id": "demo-tenant",
  "data_dir": "../data",
  "poll_interval": "2s",
  "inventory": {
    "enabled": true,
    "interval": "15m",
    "command_timeout": "10s",
    "include_processes": true,
    "include_services": true,
    "include_listeners": true,
    "include_software": true,
    "max_items": 512
  },
  "transport": {
    "enabled": false,
    "endpoint": "https://control.example:9443/v1/agent/events",
    "cert_file": "certs/client.crt",
    "key_file": "agent-identity.key",
    "ca_file": "certs/ca.crt",
    "server_name": "control.example",
    "timeout": "15s",
    "flush_interval": "2s",
    "batch_size": 100,
    "pending_warn": 10000
  },
  "native_sources": [
    {
      "id": "demo-windows-security",
      "enabled": false,
      "kind": "windows_eventlog",
      "channel": "Security",
      "event_ids": [1102, 4624, 4625, 4648, 4672, 4688, 4697, 4698, 4720, 5156, 5157],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "15s"
    },
    {
      "id": "demo-linux-journal",
      "enabled": false,
      "kind": "journald",
      "identifiers": ["sshd", "sudo"],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "15s"
    },
    {
      "id": "demo-linux-audit",
      "enabled": false,
      "kind": "auditd",
      "path": "/var/log/audit/audit.log",
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "15s"
    }
  ],
  "sources": [
    {
      "id": "demo-iis",
      "enabled": true,
      "path": "../examples/logs/iis.log",
      "format": "iis_w3c",
      "trust": "untrusted_telemetry",
      "from_start": true,
      "max_batch": 1000
    },
    {
      "id": "demo-nginx",
      "enabled": true,
      "path": "../examples/logs/nginx.log",
      "format": "nginx_combined",
      "trust": "untrusted_telemetry",
      "from_start": true,
      "max_batch": 1000
    },
    {
      "id": "demo-mysql",
      "enabled": true,
      "path": "../examples/logs/mysql-general.log",
      "format": "mysql_general",
      "trust": "untrusted_telemetry",
      "from_start": true,
      "max_batch": 1000
    },
    {
      "id": "demo-syslog",
      "enabled": true,
      "path": "../examples/logs/syslog.log",
      "format": "syslog",
      "trust": "untrusted_telemetry",
      "from_start": true,
      "max_batch": 1000
    },
    {
      "id": "demo-endpoint-events",
      "enabled": true,
      "path": "../examples/events/events.jsonl",
      "format": "jsonl",
      "trust": "untrusted_telemetry",
      "from_start": true,
      "max_batch": 1000
    }
  ],
  "api": {
    "enabled": true,
    "listen": "127.0.0.1:9477",
    "token_file": "agent-api.token"
  },
  "tools": {
    "policy_file": "../policies/default-policy.json",
    "allowed_paths": [
      "../examples",
      "../data"
    ]
  },
  "ai": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "NTAGENTSHIELD_AI_API_KEY",
    "allow_remote": false,
    "timeout": "30s"
  }
}
