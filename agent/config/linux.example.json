{
  "agent_id": "",
  "tenant_id": "replace-with-tenant-id",
  "data_dir": "/var/lib/ntagentshield",
  "poll_interval": "2s",
  "inventory": {
    "enabled": true,
    "interval": "15m",
    "command_timeout": "15s",
    "include_processes": true,
    "include_services": true,
    "include_listeners": true,
    "include_software": true,
    "max_items": 1000
  },
  "native_sources": [
    {
      "id": "linux-auth-journal",
      "enabled": true,
      "kind": "journald",
      "identifiers": ["sshd", "sudo"],
      "from_start": false,
      "max_batch": 512,
      "command_timeout": "15s"
    },
    {
      "id": "linux-kernel-journal",
      "enabled": true,
      "kind": "journald",
      "identifiers": ["kernel"],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "15s"
    },
    {
      "id": "linux-systemd-journal",
      "enabled": true,
      "kind": "journald",
      "identifiers": ["systemd"],
      "from_start": false,
      "max_batch": 256,
      "command_timeout": "15s"
    },
    {
      "id": "linux-audit",
      "enabled": true,
      "kind": "auditd",
      "path": "/var/log/audit/audit.log",
      "from_start": false,
      "max_batch": 512,
      "command_timeout": "15s"
    }
  ],
  "sources": [
    {
      "id": "nginx-access",
      "enabled": true,
      "path": "/var/log/nginx/access.log",
      "format": "nginx_combined",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    },
    {
      "id": "system-syslog",
      "enabled": true,
      "path": "/var/log/syslog",
      "format": "syslog",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    },
    {
      "id": "mysql-general",
      "enabled": false,
      "path": "/var/log/mysql/mysql.log",
      "format": "mysql_general",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    },
    {
      "id": "normalized-linux-events",
      "enabled": false,
      "path": "/var/lib/ntagentshield/ingest/linux-events.jsonl",
      "format": "jsonl",
      "trust": "untrusted_telemetry",
      "from_start": false,
      "max_batch": 5000
    }
  ],
  "api": {
    "enabled": true,
    "listen": "127.0.0.1:9477",
    "token_file": "agent-api.token"
  },
  "tools": {
    "policy_file": "/etc/ntagentshield/policies/default-policy.json",
    "allowed_paths": [
      "/var/log",
      "/var/lib/ntagentshield"
    ]
  },
  "ai": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen3-8B",
    "api_key_env": "NTAGENTSHIELD_AI_API_KEY",
    "allow_remote": false,
    "timeout": "30s"
  }
}
