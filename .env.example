NTSHIELD_DATABASE_PATH=./data/ntshield.db
NTSHIELD_RULES_PATH=./rules/behavioral
NTSHIELD_BASELINE_WARMUP_EVENTS=30
NTSHIELD_ANOMALY_FINDING_THRESHOLD=85
NTSHIELD_INCIDENT_WINDOW_SECONDS=1800

NTSHIELD_QWEN_ENABLED=true
NTSHIELD_QWEN_BASE_URL=http://127.0.0.1:8000/v1
NTSHIELD_QWEN_API_KEY=EMPTY
NTSHIELD_QWEN_MODEL=Qwen/Qwen3.5-9B
NTSHIELD_QWEN_TIMEOUT_SECONDS=120
NTSHIELD_QWEN_MAX_OUTPUT_TOKENS=4096
NTSHIELD_QWEN_TEMPERATURE=0.2

# Enrollment is disabled by default. Generate a long random secret outside the repository.
NTSHIELD_ENROLLMENT_ENABLED=false
NTSHIELD_ENROLLMENT_SIGNING_SECRET=
NTSHIELD_ENROLLMENT_CA_CERT_PATH=./data/pki/enrollment-ca.crt
NTSHIELD_ENROLLMENT_CA_KEY_PATH=./data/pki/enrollment-ca.key
NTSHIELD_ENROLLMENT_CLIENT_CERT_TTL_HOURS=720

# Policy signing uses a separate Ed25519 trust root from Agent enrollment/mTLS.
NTSHIELD_POLICY_SIGNING_PRIVATE_KEY_PATH=./data/pki/policy-signing.key
NTSHIELD_POLICY_SIGNING_PUBLIC_KEY_PATH=./data/pki/policy-signing.pub
