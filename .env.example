NTSHIELD_DATABASE_PATH=./data/ntshield.db
NTSHIELD_RULES_PATH=./rules/behavioral
NTSHIELD_BASELINE_WARMUP_EVENTS=30
NTSHIELD_ANOMALY_FINDING_THRESHOLD=85
NTSHIELD_INCIDENT_WINDOW_SECONDS=1800

NTSHIELD_QWEN_ENABLED=true
NTSHIELD_QWEN_BASE_URL=http://127.0.0.1:8000/v1
NTSHIELD_QWEN_API_KEY=EMPTY
NTSHIELD_QWEN_MODEL=Qwen/Qwen3.5-9B
NTSHIELD_QWEN_TIMEOUT_SECONDS=120
NTSHIELD_QWEN_MAX_OUTPUT_TOKENS=4096
NTSHIELD_QWEN_TEMPERATURE=0.2

# Production operator security. Generate independent random values with at least 32 bytes.
NTSHIELD_ENVIRONMENT=production
NTSHIELD_OPERATOR_AUTH_ENABLED=true
NTSHIELD_OPERATOR_SIGNING_SECRET=
NTSHIELD_OPERATOR_TOKEN_ISSUER=ntshield-control
NTSHIELD_AUDIT_HMAC_SECRET=
NTSHIELD_AUDIT_DATABASE_PATH=./data/ntshield-audit.db
NTSHIELD_OPERATOR_ALLOWED_ORIGINS=
NTSHIELD_MAX_REQUEST_BODY_BYTES=8388608
NTSHIELD_MAX_JSON_DEPTH=12
NTSHIELD_MAX_JSON_ITEMS=20000
NTSHIELD_MAX_STRING_CHARS=4096
NTSHIELD_READ_RATE_LIMIT_PER_MINUTE=600
NTSHIELD_WRITE_RATE_LIMIT_PER_MINUTE=120
NTSHIELD_INGEST_RATE_LIMIT_PER_MINUTE=3000
NTSHIELD_METRICS_PUBLIC=false
NTSHIELD_AUDIT_FAIL_CLOSED=true
NTSHIELD_TRUST_PROXY_HEADERS=false

# MCP is proposal-only and requires a short-lived responder token.
NTSHIELD_MCP_OPERATOR_TOKEN=

# Enrollment is disabled by default. Generate a long random secret outside the repository.
NTSHIELD_ENROLLMENT_ENABLED=false
NTSHIELD_ENROLLMENT_SIGNING_SECRET=
NTSHIELD_ENROLLMENT_CA_CERT_PATH=./data/pki/enrollment-ca.crt
NTSHIELD_ENROLLMENT_CA_KEY_PATH=./data/pki/enrollment-ca.key
NTSHIELD_ENROLLMENT_CLIENT_CERT_TTL_HOURS=720

# Policy signing uses a separate Ed25519 trust root from Agent enrollment/mTLS.
NTSHIELD_POLICY_SIGNING_PRIVATE_KEY_PATH=./data/pki/policy-signing.key
NTSHIELD_POLICY_SIGNING_PUBLIC_KEY_PATH=./data/pki/policy-signing.pub

# Response actions use another independent Ed25519 signing root.
# The Agent pins the public key and refuses silent signer rotation.
NTSHIELD_RESPONSE_SIGNING_PRIVATE_KEY_PATH=./data/pki/response-signing.key
NTSHIELD_RESPONSE_SIGNING_PUBLIC_KEY_PATH=./data/pki/response-signing.pub
NTSHIELD_RESPONSE_LEASE_SECONDS=120
